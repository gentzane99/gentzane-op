import fs from "node:fs";
import path from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Ajusta si tu nombre de proyecto dist es distinto
const PROJECT = "gentzane-op";

// Tipos MIME básicos (suficiente para Angular)
const MIME = {
  ".js": "text/javascript; charset=utf-8",
  ".mjs": "text/javascript; charset=utf-8",
  ".css": "text/css; charset=utf-8",
  ".html": "text/html; charset=utf-8",
  ".json": "application/json; charset=utf-8",
  ".svg": "image/svg+xml",
  ".png": "image/png",
  ".jpg": "image/jpeg",
  ".jpeg": "image/jpeg",
  ".webp": "image/webp",
  ".ico": "image/x-icon",
  ".woff": "font/woff",
  ".woff2": "font/woff2",
  ".ttf": "font/ttf",
  ".map": "application/json; charset=utf-8"
};

function isAssetRequest(urlPath) {
  // Si tiene extensión, casi seguro es asset (app.js, styles.css, woff2, etc.)
  const ext = path.extname(urlPath);
  return ext.length > 1;
}

function sendFile(res, absPath) {
  const ext = path.extname(absPath).toLowerCase();
  const type = MIME[ext] || "application/octet-stream";
  res.setHeader("Content-Type", type);
  // cache agresivo para assets hashed (Angular outputHashing)
  if (/\.[A-Z0-9]{8,}\./i.test(path.basename(absPath))) {
    res.setHeader("Cache-Control", "public, max-age=31536000, immutable");
  } else {
    res.setHeader("Cache-Control", "public, max-age=0, must-revalidate");
  }
  fs.createReadStream(absPath).pipe(res);
}

async function loadSsrHandler(locale) {
  // Tu build: dist/gentzane-op/server/es/main.server.mjs
  const ssrEntry = path.join(process.cwd(), "dist", PROJECT, "server", locale, "main.server.mjs");
  const mod = await import(pathToFileURL(ssrEntry).href);

  // Intentamos varias formas típicas de export (depende de versión/build)
  if (typeof mod.default === "function") return mod.default;
  if (typeof mod.handler === "function") return mod.handler;
  if (typeof mod.reqHandler === "function") return mod.reqHandler;

  if (typeof mod.app === "function") {
    const maybeApp = mod.app();
    if (typeof maybeApp === "function") return maybeApp; // (req,res)
    if (maybeApp?.handle) return (req, res) => maybeApp.handle(req, res);
  }

  throw new Error(`No SSR handler export found in ${ssrEntry}`);
}

export default async function handler(req, res) {
  try {
    const url = new URL(req.url, `http://${req.headers.host || "localhost"}`);
    const pathname = url.pathname;

    // Redirige / -> /es/
    if (pathname === "/") {
      res.statusCode = 307;
      res.setHeader("Location", "/es/");
      return res.end();
    }

    // Detecta locale por prefijo
    const locale = pathname.startsWith("/en") ? "en" : "es";

    // Sirve assets desde dist/.../browser/{locale}/...
    // Ej: /es/main-XXXX.js -> dist/gentzane-op/browser/es/main-XXXX.js
    if (isAssetRequest(pathname)) {
      const withoutLocalePrefix = pathname.replace(/^\/(es|en)\//, "/");
      const rel = withoutLocalePrefix.startsWith("/") ? withoutLocalePrefix.slice(1) : withoutLocalePrefix;

      const assetPath = path.join(process.cwd(), "dist", PROJECT, "browser", locale, rel);

      if (fs.existsSync(assetPath) && fs.statSync(assetPath).isFile()) {
        return sendFile(res, assetPath);
      }
      // si no existe, seguimos a SSR (por si alguien pide una ruta con punto rara)
    }

    // SSR para todo lo demás (HTML/rutas)
    const ssr = await loadSsrHandler(locale);
    return ssr(req, res);
  } catch (e) {
    res.statusCode = 500;
    res.setHeader("Content-Type", "text/plain; charset=utf-8");
    res.end(`SSR error: ${e?.message || e}`);
  }
}