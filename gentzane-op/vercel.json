{
  "functions": {
    "api/render.mjs": {
      "runtime": "nodejs20.x",
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/render" },
    { "source": "/es/:path*", "destination": "/api/render" },
    { "source": "/en/:path*", "destination": "/api/render" }
  ]
}